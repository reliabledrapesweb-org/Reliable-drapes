# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# worktrees
.worktrees/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
nul

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example for documentation)
.env*
!.env.example
.dev.vars

# vercel
.vercel

# cloudflare (OpenNext build output)
.open-next

# claude code
.claude/settings.local.json
.claude/worktrees/
.superpowers/

# editor
.vscode/

# docs (internal development notes)
docs/
TRADER_LOGIN_IFRAME.md

# typescript
*.tsbuildinfo
next-env.d.ts
