# ============================================================================
# ENVIRONMENT VARIABLES EXAMPLE
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# ============================================================================
# These variables connect your app to Supabase PostgreSQL database
# Source: Supabase Dashboard → Project Settings → API
#
# For local development with Supabase CLI:
#   NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-local-anon-key>
#
# For production (Supabase Cloud):
#   Get these from: https://supabase.com/dashboard/project/<project-id>/settings/api

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================================
# SERVER-ONLY SECRETS (Never expose to client)
# ============================================================================
# Service role key has full database access - KEEP SECRET!
# Only used on server-side (Server Actions, API routes)
# Source: Supabase Dashboard → Project Settings → API → service_role key
#
# For local development: Get from `npx supabase status` after starting local Supabase

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================================
# AUTHENTICATION (OAuth - Google)
# ============================================================================
# Google OAuth credentials for "Sign in with Google" functionality
# Source: Google Cloud Console → APIs & Services → Credentials
# Setup guide: https://developers.google.com/identity/protocols/oauth2
#
# Steps to create:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Go to Credentials → Create Credentials → OAuth client ID
# 5. Application type: Web application
# 6. Add authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google (development)
#    - https://your-domain.com/api/auth/callback/google (production)

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================================
# APPLICATION URLs
# ============================================================================
# Base URL of your application
# Used for OAuth redirects and generating absolute URLs
#
# For local development: http://localhost:3000
# For production: https://your-domain.com

NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth.js URL - CRITICAL for OAuth redirects
# Must match your deployment environment exactly
# For local development: http://localhost:3000
# For production: https://your-domain.com

NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================
# Comma-separated list of emails that will be auto-promoted to admin on signup
# These users will have full access to /admin dashboard
# Example: admin@example.com,super@example.com

ADMIN_EMAILS=admin@example.com

# ============================================================================
# LOCAL DEVELOPMENT NOTES
# ============================================================================
# 
# 1. Start local Supabase:
#    npx supabase start
#
# 2. Get local credentials:
#    npx supabase status
#
# 3. Access local services:
#    - Supabase Studio: http://localhost:54323
#    - Inbucket (emails): http://localhost:54324
#    - API URL: http://localhost:54321
#
# 4. Reset database (applies all migrations):
#    npx supabase db reset
#
# 5. Create new migration:
#    npx supabase migration new <migration_name>
#
