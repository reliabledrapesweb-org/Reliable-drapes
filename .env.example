# --- Supabase Configuration ---
# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous key (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Your Supabase service role key (found in Project Settings > API)
# WARNING: This key has admin access, keep it secret!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application Configuration ---
# The base URL of your application (used for auth callbacks and metadata)
# For local development: http://localhost:3000
# For production: https://reliabledrapes.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin Access ---
# Comma-separated list of emails that should have admin access
ADMIN_EMAILS=admin@reliabledrapes.com,manager@reliabledrapes.com

# --- Email Service (SendGrid) ---
# Your SendGrid API Key
SENDGRID_API_KEY=SG.your-api-key

# The email address that will be shown as the sender (must be verified in SendGrid)
SENDGRID_FROM_EMAIL=newsletter@reliabledrapes.com

# The name that will be shown as the sender
SENDGRID_FROM_NAME="Reliable Drapes"

# --- Development & Debugging ---
# Optional: Key used for accessing debug endpoints
DEBUG_KEY=your-secret-debug-key
