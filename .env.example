# --- Supabase Configuration ---
# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Your Supabase anonymous key (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Your Supabase service role key (found in Project Settings > API)
# WARNING: This key has admin access, keep it secret!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Application Configuration ---
# The base URL of your application (used for auth callbacks and metadata)
# For local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Admin Access ---
# Comma-separated list of emails that should have admin access
ADMIN_EMAILS=admin@example.com,manager@example.com

# --- Google OAuth Configuration ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Apple OAuth Configuration ---
NEXT_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id_here
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_apple_key_id_here
APPLE_PRIVATE_KEY="your_apple_private_key_here"

# --- SendGrid Email Configuration ---
# Get your API key from https://sendgrid.com/
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=reliabledrapesweb@gmail.com
SENDGRID_FROM_NAME="Reliable Drapes"
